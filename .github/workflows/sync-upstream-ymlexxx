name: 'Sync Upstream'

on:
  schedule:
    - cron: '0 */6 * * *'   # প্রতি ৬ ঘন্টা পর পর রান করবে
  workflow_dispatch:        # চাইলে ম্যানুয়ালি রান করাতে পারেন

jobs:
  sync_latest_from_upstream:
    runs-on: ubuntu-latest
    name: Sync latest commits from upstream repo

    steps:
      - name: Checkout target repo (your fork)
        uses: actions/checkout@v4
        with:
          ref: main
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Add upstream repo
        run: |
          git remote add upstream https://github.com/abusaeeidx/Toffee-playlist.git
          git fetch upstream

      - name: Merge upstream changes
        run: |
          git checkout main
          git merge upstream/main --no-edit

      - name: Push changes to your fork
        run: |
          git push origin main
